# HUG Photos environment template.
# Copy this file to ".env.local" and fill in real values. Never commit secrets.

# MongoDB connection string (local instance or MongoDB Atlas).
# For a zero-install local database, run `npm run db` — it starts a persistent
# MongoDB on 127.0.0.1:27017 backed by .data/mongodb.
MONGODB_URI="mongodb://127.0.0.1:27017/hugphotos"

# Random secret (16+ characters) used to sign admin session cookies.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Admin session lifetime in seconds. Default: 604800 (7 days).
AUTH_SESSION_MAX_AGE="604800"

# Maximum upload size per image, in megabytes. Default: 15.
MAX_UPLOAD_MB="15"

# Initial administrator created by `npm run init-admin` (and as a fallback on
# the first login attempt when no admin account exists yet).
ADMIN_USERNAME="clickmedia"
ADMIN_PASSWORD="clickmedia@12"

# Image storage. When all three Cloudinary values are set, uploads go to
# Cloudinary. Otherwise uploads are written to /public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudinary folder/prefix for uploaded assets. Default: hug-photos.
CLOUDINARY_FOLDER="hug-photos"

# Public base URL of the site, used for metadata. Default: http://localhost:3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
