# HUG Photos environment template.
# Copy this file to ".env.local" for local development and fill in real values.
# In production set these in your hosting provider's dashboard (e.g. Vercel →
# Project → Settings → Environment Variables). NEVER commit real secrets.

# MongoDB connection string.
# Local zero-install database: run `npm run db` (MongoDB on 127.0.0.1:27017,
# data persisted in .data/mongodb), then use the value below.
# MongoDB Atlas example (replace every <placeholder>):
#   MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hugphotos?retryWrites=true&w=majority"
MONGODB_URI="mongodb://127.0.0.1:27017/hugphotos"

# Random secret (16+ characters) used to sign admin session cookies.
# The app refuses to create sessions in production without this.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Admin session lifetime in seconds. Default: 604800 (7 days).
AUTH_SESSION_MAX_AGE="604800"

# Maximum upload size per image, in megabytes. Default: 15.
# NOTE: Vercel Serverless Functions cap request bodies at 4.5MB, so large
# uploads are streamed directly to Cloudinary from the browser (see README).
MAX_UPLOAD_MB="15"

# Initial administrator created by `npm run init-admin` (and automatically on
# the first login attempt when no administrator account exists yet).
# There is NO default password: seeding is disabled unless BOTH values below
# are set. Choose a strong password, then change it after first sign-in from
# the dashboard (Settings → Change password).
ADMIN_INITIAL_USERNAME=""
ADMIN_INITIAL_PASSWORD=""
# Legacy aliases (still honoured): ADMIN_USERNAME / ADMIN_PASSWORD

# Image storage. Cloudinary is REQUIRED in production (serverless hosts have an
# ephemeral, read-only filesystem). Set all three values to store uploads on
# Cloudinary; otherwise uploads fall back to the local /public/uploads folder.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudinary folder/prefix for uploaded assets. Default: hug-photos.
CLOUDINARY_FOLDER="hug-photos"

# Public base URL of the site, used for metadata. Default: http://localhost:3000.
# On Vercel this falls back to the deployment URL automatically when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
